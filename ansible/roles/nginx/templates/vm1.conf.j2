upstream app_backend {
    server vm2:80 max_fails=2 fail_timeout=5s;
    server vm3:80 max_fails=2 fail_timeout=5s;
}

server {
    listen 80;
    listen [::]:80;

    server_name public.vm1.local;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name public.vm1.local;

    ssl_certificate /etc/nginx/ssl/public.vm1.local.crt;
    ssl_certificate_key /etc/nginx/ssl/public.vm1.local.key;

    root /var/www/html;
    index index.html;

    location / {
        ssi on;
        try_files $uri $uri/ =404;
    }

    location = /vm2 {
        return 301 /vm2/;
    }

    location /vm2/ {
        proxy_pass http://vm2/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /vm3 {
        return 301 /vm3/;
    }

    location /vm3/ {
        proxy_pass http://vm3/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /app {
        return 301 /app/;
    }

    location /app/ {
        proxy_pass http://app_backend/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;

        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
    }
}
